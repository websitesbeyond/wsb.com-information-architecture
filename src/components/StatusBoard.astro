---
// The status board for the homepage "Technical Foundation" section.
//
// Framing: these are the standards we BUILD to — the readouts are evidence the
// engineering holds, not a description of a monitoring service. Values are
// illustrative placeholders until real project data replaces them.
//
// Status colour (green/amber) is a deliberate exception to the strict black &
// white wireframe palette: it is functional, not decorative.

// Arc path for the dial sweep.
function arc(cx: number, cy: number, r: number, startDeg: number, endDeg: number) {
  const rad = (d: number) => (d * Math.PI) / 180;
  const x1 = cx + r * Math.cos(rad(startDeg));
  const y1 = cy + r * Math.sin(rad(startDeg));
  const x2 = cx + r * Math.cos(rad(endDeg));
  const y2 = cy + r * Math.sin(rad(endDeg));
  const large = endDeg - startDeg > 180 ? 1 : 0;
  return `M ${x1} ${y1} A ${r} ${r} 0 ${large} 1 ${x2} ${y2}`;
}

// Sparkline path, normalised to the box.
function spark(vals: number[], w = 80, h = 22) {
  const min = Math.min(...vals);
  const max = Math.max(...vals);
  const span = max - min || 1;
  return vals
    .map((v, i) => {
      const x = (i / (vals.length - 1)) * w;
      const y = h - ((v - min) / span) * h;
      return `${i === 0 ? 'M' : 'L'} ${x.toFixed(1)} ${y.toFixed(1)}`;
    })
    .join(' ');
}

const metrics = [
  { label: 'Page Speed', value: '0.9s', pct: 0.92, series: [1.4, 1.2, 1.3, 1.0, 1.1, 0.95, 0.9] },
  { label: 'Accessibility', value: '100', pct: 1.0, series: [92, 94, 94, 97, 98, 100, 100] },
  { label: 'Best Practices', value: '100', pct: 1.0, series: [88, 90, 89, 93, 95, 98, 100] },
];

const states = [
  { label: 'Uptime', value: 'Online', ok: true },
  { label: 'SSL Certificate', value: 'Valid · 68d', ok: true },
  { label: 'Malware Scan', value: 'Clear', ok: true },
  { label: 'Backups', value: 'Ready · 12m ago', ok: true },
  { label: 'Form Delivery', value: 'Operational', ok: true },
  { label: 'Email Deliverability', value: 'Passing', ok: true },
  { label: 'Structured Data', value: 'Valid', ok: true },
  { label: 'Dependencies', value: '2 updates', ok: false },
  { label: 'Broken Links', value: 'None', ok: true },
];

const dot = 'inline-block w-2 h-2 rounded-full shrink-0';
---
<div class="border border-current mt-8 text-left">
  <div class="flex flex-wrap items-center justify-between gap-2 border-b border-current/20 px-6 py-3 text-xs">
    <div class="flex items-center gap-2">
      <span class={`${dot} bg-emerald-500 animate-pulse`}></span>
      <span class="font-medium">All systems nominal</span>
    </div>
    <span class="opacity-50">Last check 30 seconds ago · 1,440 checks today</span>
  </div>

  <div class="grid sm:grid-cols-3 divide-y sm:divide-y-0 sm:divide-x divide-current/20">
    {metrics.map((m) => (
      <div class="p-6 text-center">
        <svg viewBox="0 0 120 74" width="132" height="81" class="mx-auto block">
          <path d={arc(60, 62, 46, 180, 360)} fill="none" stroke="currentColor" stroke-width="3" opacity="0.15" />
          <path d={arc(60, 62, 46, 180, 180 + 180 * m.pct)} fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" />
        </svg>
        <div class="text-2xl font-bold tabular-nums -mt-2">{m.value}</div>
        <div class="text-[0.6875rem] uppercase tracking-wider opacity-50 mt-1 mb-3">{m.label}</div>
        <svg viewBox="0 0 80 22" width="80" height="22" class="mx-auto block opacity-40">
          <path d={spark(m.series)} fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        <div class="text-[0.625rem] uppercase tracking-wider opacity-40 mt-1">7-day trend</div>
      </div>
    ))}
  </div>

  <div class="border-t border-current/20 px-6 py-5 grid sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-3">
    {states.map((s) => (
      <div class="flex items-center gap-2.5 text-sm">
        <span class={`${dot} ${s.ok ? 'bg-emerald-500' : 'bg-amber-500'}`}></span>
        <span class="opacity-60">{s.label}</span>
        <span class="ml-auto font-medium tabular-nums">{s.value}</span>
      </div>
    ))}
  </div>
</div>

---
// Site-wide closing CTA. Single source of truth — drop <FuelYourMission />
// at the bottom of any page. Edit the copy here and it updates everywhere.
import Section from './Section.astro';
import RocketButton from './RocketButton.astro';
---
<Section heading="Fuel Your Mission" centered={true}>
  <p class="text-xl opacity-80">Schedule a free discovery call with a solutions architect today.</p>
  <p class="text-xl opacity-80 mt-4">Let's build something impactful together.</p>
  <div class="flex flex-wrap justify-center gap-4 mt-6">
    <RocketButton label="Schedule Discovery Call" href="/connect" />
  </div>
</Section>

---
import { navLinks } from '../data/nav';
import { url } from '../lib/url';

// Flatten the nav to a single row of real pages. "Solutions" itself has no
// href (it's a menu heading), so its column items stand in for it rather than
// the label disappearing from the footer.
const footerLinks = navLinks.flatMap((link) =>
  link.href ? [link] : (link.groups?.flatMap((g) => g.items) ?? [])
);
---
<footer class="border-t border-current mt-16">
  <div class="mx-auto max-w-7xl px-4 py-8 flex flex-wrap items-center justify-between gap-4 text-sm">
    <span class="opacity-70">Websites Beyond — wireframe</span>
    <nav class="flex flex-wrap gap-6">
      {footerLinks.map((link) => (
        <a href={url(link.href!)} class="opacity-70 hover:opacity-100">{link.label}</a>
      ))}
    </nav>
  </div>
</footer>

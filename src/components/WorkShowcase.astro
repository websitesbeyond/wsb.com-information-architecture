---
// The work showcase: one featured browser frame with the site list beside it.
//
// Ported from the POC at ~/sandbox/wsb-project-demo-widget-poc, which is where
// this is developed. Keep the two in step — the only deliberate differences are
// that this one drops the POC page's own heading (the section supplies it) and
// routes mirror URLs through the base-path helper.
//
// Each site is a curated static mirror under public/showcase/<slug>/, served
// from our own origin so interaction is live. See the POC's
// notes/mirror-architecture.md for the file contract.
import BrowserFrame from './BrowserFrame.astro';
import SitePreview from './SitePreview.astro';
import { sites } from '../data/showcase';

// Empty slots after the real sites. They do two jobs: show the list filling
// flush to the bottom of the frame rather than a few rows floating in space,
// and push it past its height so the scroll behaviour is visible while there
// are only a handful of mirrors. Drop as real sites land.
const PLACEHOLDER_SLOTS = 8;
---
{sites.length === 0 ? (
  <p class="border border-current p-6 opacity-70 text-left">
    No mirrors found in <code>public/showcase/</code>.
  </p>
) : (
  <section class="grid gap-6 items-start lg:grid-cols-[17rem_1fr] text-left" data-showcase>
    {/* Site list. Fixed to the frame's height, so it's flush top and bottom
        whatever the row count. */}
    <ul class="h-[34rem] border border-current divide-y divide-current/20 overflow-y-auto scrollbar-minimal">
      {sites.map((site, i) => (
        <li>
          <button
            type="button"
            data-target={site.slug}
            aria-current={i === 0 ? 'true' : undefined}
            class:list={[
              'w-full block px-4 py-3 text-left transition-colors hover:bg-current/10',
              i === 0 && 'bg-current/[0.06]',
            ]}
          >
            <span class="block text-sm font-medium">{site.name}</span>
            <span class="block text-xs opacity-55 mt-0.5">{site.host}</span>
            <span class="block text-[0.625rem] opacity-40 mt-1">
              {site.pages.length === 1 ? '1 page' : `${site.pages.length} pages`}
            </span>
          </button>
        </li>
      ))}

      {/* Empty slots — room for more. Hidden from assistive tech, since
          announcing eight fake sites would be noise. */}
      {Array.from({ length: PLACEHOLDER_SLOTS }).map(() => (
        <li class="px-4 py-3 opacity-30" aria-hidden="true">
          <span class="block text-sm font-medium">Placeholder Site</span>
          <span class="block text-xs mt-0.5">placeholdersite.com</span>
          <span class="block text-[0.625rem] mt-1">— pages</span>
        </li>
      ))}
    </ul>

    {/* Featured frames — one per site, only the active one in flow. */}
    <div class="min-w-0">
      {sites.map((site, i) => (
        <div data-site={site.slug} class:list={[i !== 0 && 'hidden']}>
          {/* No caption: the site list beside the frame already names the
              active site, and the address pill shows its host. */}
          <BrowserFrame host={site.host} slug={site.slug} pages={site.pages} height="34rem">
            <SitePreview site={site} />
          </BrowserFrame>
        </div>
      ))}
    </div>
  </section>
)}

<script>
  // Clicking a row swaps which featured frame is shown. The hidden frames'
  // iframes are `loading="lazy"` inside `display:none`, so they don't load
  // until first revealed — and SitePreview's ResizeObserver fires on the
  // 0 → width transition, so each frame fits itself when it appears.
  const root = document.querySelector<HTMLElement>('[data-showcase]');
  if (root) {
    const frames = Array.from(root.querySelectorAll<HTMLElement>('[data-site]'));
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('button[data-target]'));

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => {
        frames.forEach((f) => f.classList.toggle('hidden', f.dataset.site !== btn.dataset.target));
        buttons.forEach((b) => {
          const on = b === btn;
          b.classList.toggle('bg-current/[0.06]', on);
          if (on) b.setAttribute('aria-current', 'true');
          else b.removeAttribute('aria-current');
        });
      });
    });
  }
</script>
